; NC-1 v4.5
; Вывод 4, 3, 2, 1
; на индикаторы DISP_3..DISP_0
        F8 F 3        ; LDP 0xF3 — левый индикатор
        0 4           ; LDI 4
LOOP:
        2             ; STR — вывести A на индикатор
        7             ; DEX — следующий адрес: F3 -> F2 -> F1 -> F0
        9             ; DEC A — 4 -> 3 -> 2 -> 1 -> 0
        C 2           ; JZR EXIT — если A=0, выйти из цикла
        E 9           ; JR LOOP — назад к LOOP (-7)
EXIT:
        FF            ; HLT останов